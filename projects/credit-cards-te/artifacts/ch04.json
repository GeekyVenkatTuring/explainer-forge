  "captions": [
    [
      0.0,
      1.24,
      "పార్ట్ నాలుగు."
    ],
    [
      1.24,
      5.227,
      "క్రెడిట్ కార్డ్‌ను తెలివిగా వాడి లాభపడటం ఎలా?"
    ],
    [
      5.227,
      10.365,
      "రివార్డ్స్, నో-కాస్ట్ EMI నిజం, పెర్క్‌లు, మంచి అలవాట్లు —"
    ],
    [
      10.365,
      11.782,
      "ఇప్పుడు చూద్దాం."
    ],
    [
      12.282,
      17.349,
      "సరిగ్గా వాడితే, క్రెడిట్ కార్డ్ మీకు డబ్బు తిరిగి ఇస్తుంది."
    ],
    [
      17.349,
      21.814,
      "ప్రతి ఖర్చుకూ పాయింట్లు లేదా క్యాష్‌బ్యాక్ వస్తుంది."
    ],
    [
      21.814,
      22.587,
      "ఉదాహరణకు,"
    ],
    [
      22.587,
      28.426,
      "Cashback SBI Card ఆన్‌లైన్ ఖర్చులపై ఐదు శాతం క్యాష్‌బ్యాక్ ఇస్తుంది."
    ],
    [
      28.426,
      31.689,
      "Amazon Pay ICICI కార్డ్ lifetime-free,"
    ],
    [
      31.689,
      33.922,
      "Prime వాడేవారికి ఐదు శాతం."
    ],
    [
      33.922,
      38.302,
      "Axis ACE కార్డ్ బిల్ పేమెంట్‌లపై ఐదు శాతం ఇస్తుంది."
    ],
    [
      38.302,
      40.706,
      "కానీ ఒక్కటే గుర్తుంచుకోండి —"
    ],
    [
      40.706,
      44.656,
      "బిల్లు పూర్తిగా కడితేనే ఈ రివార్డ్స్‌కు అర్థం."
    ],
    [
      44.656,
      47.576,
      "లేకపోతే వడ్డీ వాటిని మింగేస్తుంది."
    ],
    [
      48.076,
      51.811,
      "ఇప్పుడు అందరూ వినే మాట — నో-కాస్ట్ EMI."
    ],
    [
      51.811,
      53.344,
      "నిజంగా ఉచితమేనా?"
    ],
    [
      53.344,
      58.995,
      "ముప్పై వేల రూపాయల వస్తువును నో-కాస్ట్ EMIలో కొన్నారనుకోండి."
    ],
    [
      58.995,
      62.443,
      "మీరు అనుకుంటారు ముప్పై వేలే కడతానని."
    ],
    [
      62.443,
      65.221,
      "కానీ లోపల వడ్డీ దాగి ఉంటుంది."
    ],
    [
      65.221,
      69.435,
      "ఆ వడ్డీపై పద్దెనిమిది శాతం GST మీరే కట్టాలి."
    ],
    [
      69.435,
      73.17,
      "పైగా ప్రాసెసింగ్ ఫీజు, దానిపై కూడా GST."
    ],
    [
      73.17,
      77.193,
      "చాలాసార్లు క్యాష్‌బ్యాక్ కూడా రద్దవుతుంది."
    ],
    [
      77.193,
      80.641,
      "కాబట్టి నో-కాస్ట్ EMI అనేది పేరుకే —"
    ],
    [
      80.641,
      83.706,
      "నిజంగా కొంత అదనపు ఖర్చు ఉంటుంది."
    ],
    [
      84.206,
      85.767,
      "రివార్డ్స్ కాకుండా,"
    ],
    [
      85.767,
      89.217,
      "మంచి కార్డులు ఇంకా చాలా పెర్క్‌లు ఇస్తాయి."
    ],
    [
      89.217,
      93.736,
      "ఎయిర్‌పోర్ట్ లాంజ్ యాక్సెస్ — ప్రయాణంలో ఉచిత విశ్రాంతి."
    ],
    [
      93.736,
      97.432,
      "పెట్రోల్ కొంటే ఫ్యూయల్ సర్‌ఛార్జ్ మినహాయింపు."
    ],
    [
      97.432,
      100.472,
      "ట్రావెల్ ఇన్సూరెన్స్, కొనుగోలు రక్షణ."
    ],
    [
      100.472,
      104.333,
      "విదేశాలకు వెళ్ళేవారికి జీరో-ఫారెక్స్ కార్డులు —"
    ],
    [
      104.333,
      107.208,
      "విదేశీ ఖర్చులపై అదనపు ఛార్జ్ ఉండదు."
    ],
    [
      107.208,
      111.316,
      "మీ అవసరానికి తగ్గ పెర్క్‌లు ఉన్న కార్డ్ ఎంచుకోండి."
    ],
    [
      111.816,
      117.513,
      "చివరగా, ప్రతి తెలివైన కార్డ్ వాడకందారుకు ఉండే ఐదు అలవాట్లు."
    ],
    [
      117.513,
      120.024,
      "ఒకటి — ఆటోపే సెటప్ చేయండి."
    ],
    [
      120.024,
      123.596,
      "అప్పుడు గడువు తేదీ ఎప్పుడూ మిస్ కాదు."
    ],
    [
      123.596,
      129.39,
      "రెండు — ప్రతి నెలా మినిమం కాదు, టోటల్ డ్యూ పూర్తిగా కట్టండి."
    ],
    [
      129.39,
      133.542,
      "మూడు — ప్రతి ఖర్చును యాప్‌లో ట్రాక్ చేయండి."
    ],
    [
      133.542,
      137.887,
      "నాలుగు — యుటిలైజేషన్ ముప్పై శాతం లోపు ఉంచండి."
    ],
    [
      137.887,
      141.267,
      "ఐదు — అనవసరంగా చాలా కార్డులు వద్దు."
    ],
    [
      141.267,
      143.198,
      "క్రమశిక్షణతో వాడండి."
    ]
