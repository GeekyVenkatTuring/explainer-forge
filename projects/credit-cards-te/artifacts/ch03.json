  "captions": [
    [
      0.0,
      1.076,
      "పార్ట్ మూడు."
    ],
    [
      1.076,
      2.51,
      "క్రెడిట్ స్కోర్."
    ],
    [
      2.51,
      8.426,
      "మీకు అప్పు ఇవ్వాలా వద్దా అని బ్యాంకులు దీన్ని బట్టే నిర్ణయిస్తాయి."
    ],
    [
      8.426,
      10.846,
      "దీన్ని ఎలా పెంచాలో చూద్దాం."
    ],
    [
      11.346,
      16.641,
      "భారతదేశంలో అత్యంత ముఖ్యమైన క్రెడిట్ స్కోర్ — CIBIL స్కోర్."
    ],
    [
      16.641,
      20.566,
      "దీన్ని TransUnion CIBIL అనే సంస్థ ఇస్తుంది."
    ],
    [
      20.566,
      25.404,
      "ఇది మూడు వందల నుండి తొమ్మిది వందల మధ్య ఉండే ఒక సంఖ్య."
    ],
    [
      25.404,
      27.869,
      "ఎంత ఎక్కువ ఉంటే అంత మంచిది."
    ],
    [
      27.869,
      31.703,
      "సాధారణంగా ఏడు వందల యాభై కంటే ఎక్కువ ఉంటే —"
    ],
    [
      31.703,
      34.533,
      "అద్భుతమైన స్కోర్‌గా భావిస్తారు."
    ],
    [
      34.533,
      38.002,
      "అప్పుడు తక్కువ వడ్డీకే రుణాలు వస్తాయి."
    ],
    [
      38.502,
      43.224,
      "మీ స్కోర్‌ను ప్రభావితం చేసే అతి పెద్ద అంశాల్లో ఒకటి —"
    ],
    [
      43.224,
      45.096,
      "క్రెడిట్ యుటిలైజేషన్."
    ],
    [
      45.096,
      49.194,
      "అంటే మీ లిమిట్‌లో ఎంత శాతం వాడుతున్నారు అనేది."
    ],
    [
      49.194,
      52.224,
      "ఉదాహరణకు లిమిట్ లక్ష రూపాయలు ఉండి,"
    ],
    [
      52.224,
      56.322,
      "మీరు ఇరవై ఐదు వేలు వాడితే — అది ఇరవై ఐదు శాతం."
    ],
    [
      56.322,
      57.57,
      "ఇది ఆరోగ్యకరం."
    ],
    [
      57.57,
      62.47,
      "నియమం సింపుల్ — ఎప్పుడూ ముప్పై శాతం కంటే తక్కువ వాడండి."
    ],
    [
      62.47,
      64.163,
      "డెబ్బై శాతం దాటితే,"
    ],
    [
      64.163,
      68.975,
      "మీరు డబ్బు కోసం ఇబ్బందిలో ఉన్నారని బ్యాంకులకు సంకేతం —"
    ],
    [
      68.975,
      70.846,
      "స్కోర్ దెబ్బతింటుంది."
    ],
    [
      71.346,
      75.306,
      "మీ CIBIL స్కోర్‌ను ఏవి నిర్ణయిస్తాయో చూద్దాం."
    ],
    [
      75.306,
      79.002,
      "అన్నిటికంటే ముఖ్యమైనది — చెల్లింపు చరిత్ర."
    ],
    [
      79.002,
      82.962,
      "అంటే మీరు సకాలంలో బిల్లులు కడుతున్నారా అనేది."
    ],
    [
      82.962,
      85.69,
      "రెండోది — క్రెడిట్ యుటిలైజేషన్."
    ],
    [
      85.69,
      89.65,
      "తర్వాత మీ క్రెడిట్ ఖాతాల వయస్సు, రకాల మిక్స్,"
    ],
    [
      89.65,
      91.498,
      "కొత్త రుణ దరఖాస్తులు."
    ],
    [
      91.498,
      95.37,
      "కాబట్టి సకాలంలో కట్టడం, తక్కువ యుటిలైజేషన్ —"
    ],
    [
      95.37,
      97.57,
      "ఈ రెండే స్కోర్‌కు పునాది."
    ],
    [
      98.07,
      101.203,
      "మరి మొదటి క్రెడిట్ కార్డ్ ఎలా పొందాలి?"
    ],
    [
      101.203,
      104.007,
      "మీకు క్రమమైన జీతం లేదా ఆదాయం ఉంటే,"
    ],
    [
      104.007,
      106.563,
      "బ్యాంకు నేరుగా కార్డ్ ఇస్తుంది."
    ],
    [
      106.563,
      111.016,
      "క్రెడిట్ చరిత్ర లేకపోతే — సెక్యూర్డ్ కార్డ్ తీసుకోండి."
    ],
    [
      111.016,
      114.479,
      "దీనికి మీరు ఒక ఫిక్స్‌డ్ డిపాజిట్ పెడతారు,"
    ],
    [
      114.479,
      116.87,
      "దాని ఆధారంగా కార్డ్ వస్తుంది."
    ],
    [
      116.87,
      121.653,
      "లేదా కుటుంబ సభ్యుడి కార్డ్‌పై యాడ్-ఆన్ కార్డ్ తీసుకోవచ్చు."
    ],
    [
      121.653,
      125.775,
      "మొదటి కార్డ్‌కు lifetime-free కార్డులే ఎంచుకోండి —"
    ],
    [
      125.775,
      127.342,
      "వార్షిక ఫీజు ఉండదు."
    ]
  ],
