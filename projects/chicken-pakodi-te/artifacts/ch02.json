      4.862,
      "ముందు పోటీని అర్థం చేసుకోండి."
    ],
    [
      4.862,
      10.366,
      "హైదరాబాద్‌లో పాపులర్ చోట్ల చికెన్ పకోడీ ఎంతకు అమ్ముతున్నారు?"
    ],
    [
      10.866,
      14.259,
      "హైదరాబాద్‌లో ధరలు ఎలా ఉన్నాయో చూద్దాం."
    ],
    [
      14.259,
      18.278,
      "డిల్‌సుఖ్‌నగర్‌లోని A1 చికెన్ పకోడీ పాయింట్ —"
    ],
    [
      18.278,
      20.421,
      "ఇదే ఐకానిక్ స్పెషలిస్ట్."
    ],
    [
      20.421,
      24.172,
      "ఒక ప్లేట్ నూట యాభై నుండి నూట ఎనభై రూపాయలు."
    ],
    [
      24.172,
      28.905,
      "కుకట్‌పల్లిలోని క్వాలిటీ చికెన్ పకోడీ కూడా అలాంటిదే —"
    ],
    [
      28.905,
      31.673,
      "నూట యాభై నుండి రెండు వందల మధ్య."
    ],
    [
      31.673,
      35.246,
