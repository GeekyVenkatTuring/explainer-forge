  [
   0.0,
   0.691,
   "Part six."
  ],
  [
   0.691,
   1.727,
   "The big picture."
  ],
  [
   2.359,
   5.123,
   "We have built the whole theory from a"
  ],
  [
   5.123,
   6.16,
   "single surprising event."
  ],
  [
   6.16,
   8.233,
   "Before we gather it all together,"
  ],
  [
   8.233,
   10.997,
   "let's push the very idea of information to"
  ],
  [
   10.997,
   13.761,
   "its philosophical limit \u2014 and then watch it"
  ],
  [
   13.761,
   15.488,
   "echo across all of science."
  ],
  [
   15.988,
   17.478,
   "Shannon's entropy is powerful,"
  ],
  [
   17.478,
   19.713,
   "but it has one quiet requirement."
  ],
  [
   19.713,
   22.694,
   "It needs a probability distribution \u2014 a source"
  ],
  [
   22.694,
   24.929,
   "that emits symbols with known odds."
  ],
  [
   25.561,
   27.796,
   "But here is a haunting question."
  ],
  [
   27.796,
   30.776,
   "What is the information content of one single,"
  ],
  [
   30.776,
   31.521,
   "fixed object?"
  ],
  [
   31.521,
   32.639,
   "Not a source."
  ],
  [
   32.639,
   33.011,
   "Just..."
  ],
  [
   33.011,
   35.247,
   "this one specific string of characters,"
  ],
  [
   35.247,
   36.737,
   "sitting on the page."
  ],
  [
   36.737,
   38.972,
   "There are no probabilities in sight."
  ],
  [
   39.604,
   42.584,
   "The answer is one of the deepest ideas"
  ],
  [
   42.584,
   44.819,
   "in computer science \u2014 Kolmogorov complexity."
  ],
  [
   45.451,
   48.431,
   "It defines the information in an object as"
  ],
  [
   48.431,
   51.412,
   "the length of the shortest computer program that"
  ],
  [
   51.412,
   52.529,
   "can reproduce it."
  ],
  [
   53.161,
   55.023,
   "Look at the first string."
  ],
  [
   55.023,
   56.886,
   "A-B repeated ten times over."
  ],
  [
   56.886,
   58.004,
   "It looks long,"
  ],
  [
   58.004,
   60.984,
   "but you can describe it in a tiny"
  ],
  [
   60.984,
   61.357,
   "breath:"
  ],
  [
   61.357,
   62.102,
   "print A-B,"
  ],
  [
   62.102,
   62.847,
   "ten times."
  ],
  [
   62.847,
   63.965,
   "A short program."
  ],
  [
   63.965,
   65.827,
   "So its complexity is low."
  ],
  [
   65.827,
   67.317,
   "It is deeply compressible."
  ],
  [
   67.949,
   70.929,
   "Now look at the second string \u2014 a"
  ],
  [
   70.929,
   73.91,
   "jumble of random letters and digits with no"
  ],
  [
   73.91,
   75.027,
   "pattern at all."
  ],
  [
   75.659,
   78.639,
   "What is the shortest program that prints it?"
  ],
  [
   78.639,
   80.502,
   "There is no clever shortcut,"
  ],
  [
   80.502,
   81.992,
   "no rule to exploit."
  ],
  [
   81.992,
   83.855,
