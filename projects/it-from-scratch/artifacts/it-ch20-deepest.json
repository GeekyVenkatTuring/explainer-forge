  ],
  [
   87.839,
   90.447,
   "So a truly random object is incompressible."
  ],
  [
   90.447,
   92.682,
   "Its shortest description is just itself."
  ],
  [
   92.682,
   94.918,
   "And that gives us a stunning,"
  ],
  [
   94.918,
   96.408,
   "precise definition of randomness."
  ],
  [
   97.039,
   98.157,
   "Random means incompressible."
  ],
  [
   98.157,
   101.137,
   "Random means maximally informative \u2014 there is\nsimply"
  ],
  [
   101.137,
   103.0,
   "no shorter story to tell."
  ],
  [
