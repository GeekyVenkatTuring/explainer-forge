      "t": "  void execute();",
      "s": "add"
     },
     {
      "t": "  void undo();",
      "s": "add"
     },
     {
      "t": "}",
      "s": "add"
     }
    ],
    "note": "Do and undo, bound together \u2014 that pairing is the whole idea.",
    "dur": 23.122
   }
  },
  {
   "id": "dp05-command_refactor2",
   "type": "dp_refactor",
   "in_seconds": 219.953,
   "out_seconds": 249.135,
   "props": {
    "step": 2,
    "of": 3,
    "move": "Each command captures its own data",
    "file": "BoldCommand.java",
    "lines": [
     {
      "t": "class BoldCommand implements Command {",
      "s": "add"
     },
     {
      "t": "  private final Document doc;",
      "s": "add"
     },
     {
      "t": "  private final Range selection;   // captured!",
      "s": "add"
     },
     {
      "t": "  public void execute() { doc.applyBold(selection); }",
      "s": "add"
     },
     {
      "t": "  public void undo()    { doc.removeBold(selection); }",
      "s": "add"
     },
     {
      "t": "}"
     }
    ],
    "note": "The selection it needs to undo is stored inside the command itself.",
    "dur": 29.682
   }
