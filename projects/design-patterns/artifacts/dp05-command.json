  {
   "id": "dp05-command_refactor3",
   "type": "dp_refactor",
   "in_seconds": 280.717,
   "out_seconds": 311.968,
   "props": {
    "step": 3,
    "of": 3,
    "move": "The invoker just runs and stacks them",
    "file": "Editor.java",
    "lines": [
     {
      "t": "class Editor {"
     },
     {
      "t": "  private final Deque<Command> history = new ArrayDeque<>();",
      "s": "add"
     },
     {
      "t": "  void run(Command c) {",
      "s": "add"
     },
     {
      "t": "    c.execute();",
      "s": "add"
     },
     {
      "t": "    history.push(c);          // remember it",
      "s": "add"
     },
     {
      "t": "  }",
      "s": "add"
     },
     {
      "t": "  void undo() { history.pop().undo(); }   // that's it",
      "s": "add"
     },
     {
      "t": "}"
     }
    ],
    "note": "One run(), one undo() \u2014 and they work for every command, forever.",
    "dur": 31.751
   }
  },
