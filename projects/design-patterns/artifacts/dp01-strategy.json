      "t": "class ShippingCalculator {"
     },
     {
      "t": "  double cost(Order order, String method) {"
     },
     {
      "t": "    double w = order.weight();"
     },
     {
      "t": "    if (method.equals(\"STANDARD\"))  return 5.00 + w * 0.50;",
      "s": "hi"
     },
     {
      "t": "    if (method.equals(\"EXPRESS\"))   return 15.00 + w * 0.75;",
      "s": "hi"
     },
     {
      "t": "    if (method.equals(\"OVERNIGHT\")) return 30.00 + w * 1.20;",
      "s": "hi"
     },
     {
      "t": "    throw new IllegalArgumentException(\"method: \" + method);"
     },
     {
      "t": "  }"
     },
     {
      "t": "}"
     }
    ],
