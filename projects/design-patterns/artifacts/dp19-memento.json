     {
      "t": "class History {",
      "s": "hi"
     },
     {
      "t": "  private final Deque<Memento> stack = new ArrayDeque<>();",
      "s": "hi"
     },
     {
      "t": "  void push(Memento m) { stack.push(m); }   // just store",
      "s": "hi"
     },
