  {
   "id": "dp21-prototype_refactor1",
   "type": "dp_refactor",
   "in_seconds": 235.035,
   "out_seconds": 271.492,
   "props": {
    "step": 1,
    "of": 3,
    "move": "The object clones itself",
    "file": "Enemy.java",
    "lines": [
     {
      "t": "interface Enemy { Enemy clone(); }",
      "s": "add"
     },
     {
      "t": "class Orc implements Enemy {"
     },
     {
      "t": "  Mesh mesh; int hp; AI ai; ...;"
     },
     {
      "t": "  public Orc clone() {              // copy myself",
      "s": "add"
     },
     {
      "t": "    Orc c = new Orc();",
      "s": "add"
     },
     {
      "t": "    c.mesh = this.mesh; c.hp = this.hp;   // share/copy",
      "s": "add"
     },
     {
      "t": "    c.ai = this.ai.clone();   // deep-copy mutable bits",
      "s": "add"
     },
     {
      "t": "    return c;",
      "s": "add"
     },
     {
      "t": "  }"
     },
     {
      "t": "}"
     }
    ],
    "note": "The Orc knows how to copy itself \u2014 including which parts to deep-copy.",
    "dur": 36.957
   }
  },
  {
   "id": "dp21-prototype_refactor2",
   "type": "dp_refactor",
   "in_seconds": 271.992,
   "out_seconds": 308.244,
   "props": {
    "step": 2,
    "of": 3,
    "move": "A registry of ready-made prototypes",
    "file": "Bestiary.java",
    "lines": [
     {
      "t": "class Bestiary {",
      "s": "hi"
     },
     {
      "t": "  private Map<String,Enemy> prototypes = new HashMap<>();",
      "s": "hi"
     },
     {
      "t": "  void register(String key, Enemy p) { prototypes.put(key, p); }",
      "s": "hi"
     },
     {
      "t": "  Enemy spawn(String key) {",
      "s": "hi"
     },
     {
      "t": "    return prototypes.get(key).clone();   // copy, don't build",
      "s": "hi"
     },
     {
      "t": "  }"
     },
     {
      "t": "}"
     }
    ],
    "note": "Configure each prototype ONCE, register it. Spawning is just clone().",
    "dur": 36.752
   }
  },
