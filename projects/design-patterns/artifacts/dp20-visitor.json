  {
   "id": "dp20-visitor_refactor1",
   "type": "dp_refactor",
   "in_seconds": 245.621,
   "out_seconds": 278.273,
   "props": {
    "step": 1,
    "of": 3,
    "move": "A Visitor interface; elements just accept",
    "file": "Visitor.java",
    "lines": [
     {
      "t": "interface Visitor {              // one visit per type",
      "s": "add"
     },
     {
      "t": "  void visitText(Text t);",
      "s": "add"
     },
     {
      "t": "  void visitImage(Image i);",
      "s": "add"
     },
     {
      "t": "}",
      "s": "add"
     },
     {
      "t": "interface Element { void accept(Visitor v); }",
      "s": "hi"
     },
     {
      "t": "// each element implements ONE method: accept"
     }
    ],
    "note": "Elements gain a single method \u2014 accept \u2014 forever. Operations live in visitors.",
    "dur": 33.152
   }
  },
  {
   "id": "dp20-visitor_refactor2",
   "type": "dp_refactor",
   "in_seconds": 278.773,
   "out_seconds": 319.408,
   "props": {
    "step": 2,
    "of": 3,
    "move": "One visitor = one operation, all types",
    "file": "HtmlVisitor.java",
    "lines": [
     {
      "t": "class HtmlVisitor implements Visitor {",
      "s": "hi"
     },
     {
      "t": "  public void visitText(Text t)  { out += \"<p>\"+t.body+\"</p>\"; }",
      "s": "hi"
     },
     {
      "t": "  public void visitImage(Image i){ out += \"<img src=\"+i.url+\">\"; }",
      "s": "hi"
     },
     {
      "t": "}"
     },
     {
      "t": "// and Text.accept simply calls back:"
     },
     {
      "t": "void accept(Visitor v) { v.visitText(this); }  // double dispatch",
      "s": "hi"
     }
    ],
    "note": "All the HTML logic, every element, in ONE class. accept picks the visit.",
    "dur": 41.135
   }
  },
  {
   "id": "dp20-visitor_try",
   "type": "dp_try",
