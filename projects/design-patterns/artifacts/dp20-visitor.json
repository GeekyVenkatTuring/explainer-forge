  },
  {
   "id": "dp20-visitor_refactor3",
   "type": "dp_refactor",
   "in_seconds": 351.738,
   "out_seconds": 389.649,
   "props": {
    "step": 3,
    "of": 3,
    "move": "Run a visitor; add another for free",
    "file": "app.java",
    "lines": [
     {
      "t": "HtmlVisitor html = new HtmlVisitor();"
     },
     {
      "t": "for (Element e : document) e.accept(html);   // render all",
      "s": "add"
     },
     {
      "t": "// want word count instead? a whole new operation:"
     },
     {
      "t": "WordCountVisitor wc = new WordCountVisitor();",
      "s": "add"
     },
     {
      "t": "for (Element e : document) e.accept(wc);   // ZERO element edits",
      "s": "hi"
     }
    ],
    "note": "Swap the visitor, get a whole new operation. Elements never changed.",
    "dur": 38.411
   }
  },
