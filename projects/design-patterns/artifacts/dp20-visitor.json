     {
      "emoji": "\ud83d\udcc4",
      "label": "Stable element types"
     },
     {
      "emoji": "\u2699\ufe0f",
      "label": "Growing operations"
     },
     {
      "emoji": "\u2795",
      "label": "\u2026added constantly"
     }
    ],
    "ask": "How do you add a new operation over every element type without editing each one?",
    "dur": 39.143
   }
  },
  {
