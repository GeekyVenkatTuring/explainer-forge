  {
   "id": "dp03-decorator_refactor2",
   "type": "dp_refactor",
   "in_seconds": 209.727,
   "out_seconds": 239.557,
   "props": {
    "step": 2,
    "of": 3,
    "move": "A wrapper that is also a drink",
    "file": "AddOn.java",
    "lines": [
     {
      "t": "// wraps a Beverage, and IS a Beverage"
     },
     {
      "t": "abstract class AddOn implements Beverage {",
      "s": "add"
     },
     {
      "t": "  protected final Beverage inner;",
      "s": "add"
     },
     {
      "t": "  AddOn(Beverage inner) { this.inner = inner; }",
      "s": "add"
     },
     {
      "t": "}"
     },
     {
      "t": "class Milk extends AddOn {",
      "s": "add"
     },
     {
      "t": "  Milk(Beverage b) { super(b); }",
      "s": "add"
     },
     {
      "t": "  public double cost() { return inner.cost() + 0.50; }",
      "s": "add"
     },
     {
      "t": "  public String desc() { return inner.desc() + \", milk\"; }",
      "s": "add"
     },
     {
      "t": "}"
     }
    ],
    "note": "The wrapper holds the layer inside, and adds to whatever it returns.",
    "dur": 30.33
   }
