    "lines": [
     {
      "t": "abstract class Importer {",
      "s": "add"
     },
     {
      "t": "  public final void run(File f) {   // the template \u2014 final!",
      "s": "add"
     },
     {
      "t": "    var raw = open(f);",
      "s": "add"
     },
     {
      "t": "    var rows = parse(raw);          // a hole",
      "s": "add"
     },
     {
      "t": "    validate(rows); dedupe(rows); save(rows);",
      "s": "add"
     },
     {
      "t": "  }",
      "s": "add"
     },
     {
      "t": "  protected abstract List<Row> parse(String raw);  // fill me",
      "s": "add"
     },
     {
      "t": "}"
     }
    ],
    "note": "run() is final \u2014 the sequence is locked. parse() is the hole.",
    "dur": 30.151
   }
  },
  {
