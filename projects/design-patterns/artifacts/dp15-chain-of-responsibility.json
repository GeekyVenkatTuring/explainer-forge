    "move": "Concrete approvers, then wire the chain",
    "file": "setup.java",
    "lines": [
     {
      "t": "class TeamLead extends Approver { TeamLead(){ super(500); } }",
      "s": "hi"
     },
     {
      "t": "class Manager  extends Approver { Manager(){ super(5_000); } }",
      "s": "hi"
     },
     {
