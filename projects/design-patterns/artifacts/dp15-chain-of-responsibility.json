  {
   "id": "dp15-chain-of-responsibility_refactor1",
   "type": "dp_refactor",
   "in_seconds": 220.551,
   "out_seconds": 252.801,
   "props": {
    "step": 1,
    "of": 3,
    "move": "Each approver: a limit, a next, a handle()",
    "file": "Approver.java",
    "lines": [
     {
      "t": "abstract class Approver {",
      "s": "add"
     },
     {
      "t": "  protected Approver next;          // the one above",
      "s": "add"
     },
     {
      "t": "  protected final long limit;",
      "s": "add"
     },
     {
      "t": "  void handle(Expense e) {",
      "s": "add"
     },
     {
      "t": "    if (e.amount() <= limit) sign(e);       // I can",
      "s": "add"
     },
     {
      "t": "    else if (next != null) next.handle(e);  // escalate",
      "s": "add"
     },
     {
      "t": "  }",
      "s": "add"
     },
     {
      "t": "}"
     }
    ],
    "note": "The escalation logic is written ONCE, in the base handler.",
    "dur": 32.75
   }
  },
  {
   "id": "dp15-chain-of-responsibility_refactor2",
