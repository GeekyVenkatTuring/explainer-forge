   "in_seconds": 94.383,
   "out_seconds": 130.365,
   "props": {
    "title": "\"Fine \u2014 load them lazily, then.\"",
    "file": "leaked.java",
    "lines": [
     {
      "t": "void drawPage(int p) {"
     },
     {
      "t": "  for (Image img : pageImages(p)) {"
     },
     {
      "t": "    if (!img.isLoaded()) img.load();  // lazy check\u2026",
      "s": "hi"
     },
     {
      "t": "    img.draw();"
     },
     {
      "t": "  }"
     },
     {
      "t": "// the same guard in getWidth(), export(), print()\u2026",
      "s": "hi"
     }
    ],
    "smell": "Lazy-loading logic smeared across every caller",
    "touched": [
     "every draw() guarded by isLoaded()",
     "getWidth/getHeight need the same guard",
     "forget one \u2192 a blank or a crash",
     "Document now knows about loading"
    ],
    "dur": 36.482
   }
  },
  {
