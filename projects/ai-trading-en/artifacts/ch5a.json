      "props": {
        "kicker": "BOX 1, DONE RIGHT",
        "title": "Clean data before you trust it",
        "file": "clean.py",
        "color": "data",
        "lines": [
          "def clean(df):",
          "    df = df[~df.index.duplicated()]   # drop dupes",
          "    df = df.sort_index()              # time order",
          "    df = df.ffill(limit=2)            # small gaps only",
          "    df = df.dropna()                  # then drop rest",
          "    # sanity: no zero or negative prices",
          "    df = df[df['Close'] > 0]",
          "    return df"
        ],
        "side": {
          "title": "Cleaning checklist",
          "points": [
            "Remove duplicate timestamps",
            "Sort strictly by time",
            "Fill only tiny gaps \u2014 never invent data",
            "Reject impossible prices (0 or negative)"
          ]
        },
        "caption": "Ninety percent of 'my bot is broken' turns out to be dirty data.",
        "dur": 46.381
